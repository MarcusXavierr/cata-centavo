{
  "name": "cata-centavo",
  "version": "0.0.0",
  "description": "MCP server for Brazilian Open Finance data, via Pluggy",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "open-finance",
    "pluggy",
    "finance"
  ],
  "license": "MIT",
  "author": "Marcus Xavier",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarcusXavierr/cata-centavo.git"
  },
  "homepage": "https://github.com/MarcusXavierr/cata-centavo#readme",
  "bugs": {
    "url": "https://github.com/MarcusXavierr/cata-centavo/issues"
  },
  "type": "module",
  "bin": {
    "cata-centavo": "./dist/bin/cata-centavo.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node src/bin/cata-centavo.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "pluggy-sdk": "^0.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
